# ─── Database ────────────────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string.
# Local: defina aqui (em .env.local) com a string da sua Neon branch de dev.
# Vercel (Production/Preview): populada automaticamente pela integração Vercel-Neon
# — Preview recebe uma Neon branch isolada por PR, Production aponta pra Neon main.
# Não setar manualmente no painel do Vercel; a integração toma conta.
DATABASE_URL=

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
# Random secret for signing sessions — generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (e.g. https://palpiteiro.vercel.app)
AUTH_URL=
# Resend API key used by Auth.js to send magic-link emails
AUTH_RESEND_KEY=
# Google OAuth client (método de login primário — ADR 0023). Auto-detectados pelo
# Auth.js v5 a partir destes nomes. Crie em https://console.cloud.google.com/apis/credentials
# (OAuth client ID, tipo "Web application"); redirect URI: <AUTH_URL>/api/auth/callback/google.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Whitelist de e-mails autorizados a logar (cost-safe: o callback signIn recusa
# fora-da-lista ANTES de enviar o magic link). Lista separada por vírgula,
# case-insensitive. Comece só com o seu e-mail; adicione amigos editando aqui +
# redeploy. Ex.: voce@exemplo.com,amigo@gmail.com
ALLOWED_EMAILS=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Verified sender address in Resend. Sem domínio verificado, o Resend só envia
# pro e-mail da sua própria conta (modo teste, onboarding@resend.dev). Pra
# convidar amigos, verifique um domínio e troque por ex. no-reply@seudominio.com
RESEND_FROM_EMAIL=

# ─── Anthropic / AI ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OpenAI (ADR 0027 / #231): provider de PROVA admin-only. AUSENTE ⇒ gpt-5-mini é
# INERTE (filtrado de modelsForAudience, nunca roteado, zero gasto). Só preencher
# pra armar o provider e rodar o A/B dev-only (key-gate, padrão SportMonks/#227).
OPENAI_API_KEY=
# TypeSafe (ADR 0041 / #510): JEV, camada de julgamentos entre o λ estatístico e
# o gate. AUSENTE ⇒ fail-open: a análise segue com o λ estatístico puro, zero gasto.
TYPESAFE_API_KEY=

# ─── External data providers ─────────────────────────────────────────────────
# The Odds API v4 — free tier: 500 req/month (≈16/day); cache aggressively.
# Auth via query param `?apiKey=<key>` (NÃO header). Quota counters retornam
# nos headers x-requests-remaining / x-requests-used. Sign-up:
# https://the-odds-api.com/ · Doc: https://the-odds-api.com/liveapi/guides/v4/
ODDS_API_KEY=
# API-Football — Pro plan: 7500 req/day (chave de prod, observado via GET /status;
# o free tier seria 100/dia). Use direct plan (api-sports.io), NÃO RapidAPI.
# Auth via header x-apisports-key; obtain a key at https://dashboard.api-football.com/.
# OBRIGATÓRIO em prod (provider primário de sports-data E de desfalques, #227).
API_FOOTBALL_KEY=
# football-data.org v4 — free tier: 10 req/min, ~10 competitions covered including
# BSA (Campeonato Brasileiro Série A) and CL (UEFA Champions League). Auth via
# header X-Auth-Token. Sign-up: https://www.football-data.org/client/register
# Doc: https://docs.football-data.org/general/v4/
FOOTBALL_DATA_ORG_API_KEY=

# ─── Sports data composition (issue #24) ─────────────────────────────────────
# SportsDataProvider primary/fallback selection. Cascade kicks in on transient
# errors from the primary (5xx, 429-after-retry, timeout, schema drift, envelope
# errors like "account suspended"). 4xx ≠ 429 does NOT cascade. Values:
#   api-football | football-data-org
SPORTS_DATA_PRIMARY=api-football
SPORTS_DATA_FALLBACK=football-data-org

# ─── Desfalques (AbsencesProvider, ADR 0026 / #227) ──────────────────────────
# Cascata DEDICADA de desfalques (lesões/suspensões), separada de SportsDataProvider.
# Primário 'sports-data' = wrapper da cascata api-football existente (já cobre BR/CL).
# Fallback 'sportmonks' = KEY-GATED: sem SPORTMONKS_API_TOKEN o adapter tem
# supportsAbsences=false e é FILTRADO no gate (inerte, zero gasto, zero mudança de
# comportamento). Setar o token ATIVA o hedge. Valores: sports-data | sportmonks
ABSENCES_PRIMARY=sports-data
ABSENCES_FALLBACK=sportmonks
# SportMonks Football API v3 (entidade `sidelined`). OPCIONAL — hedge de
# redundância; sem ele a análise usa só a api-football. Auth via api_token.
# Sign-up/trial: https://www.sportmonks.com/football-api/
SPORTMONKS_API_TOKEN=

# ─── Cron (settlement) ───────────────────────────────────────────────────────
# Shared secret for the daily settlement cron (/api/cron/settle-predictions).
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. The route fails
# closed (500) if unset and rejects (401) on mismatch. Generate with:
# openssl rand -base64 32 — then set it in the Vercel project (Production+Preview).
CRON_SECRET=

# ─── AI spend alert (issue #75) ───────────────────────────────────────────────
# Daily email alert when aggregate AI spend (sum of ai_calls.cost_usd for the
# current UTC day) exceeds this threshold in USD. OPT-IN: leave unset (or <=0) to
# disable the alert entirely — no email is ever sent. Fired by the daily cron
# /api/cron/spend-alert (23:00 UTC). Sent via Resend (reuses AUTH_RESEND_KEY +
# RESEND_FROM_EMAIL) and de-duplicated per UTC day via Vercel KV.
DAILY_AI_SPEND_ALERT_USD=
# Recipient address for the spend alert. If unset, the cron runs but sends
# nothing (skips with a warning).
SPEND_ALERT_EMAIL=

# ─── Vercel KV (Redis) ───────────────────────────────────────────────────────
# Populated automatically by Vercel when KV store is linked to the project
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Rate limiting (analyses per user/day — protege custo Anthropic) ──────────
# Teto diário por usuário em analyzeMatch, aplicado ANTES de qualquer chamada à
# Anthropic (custo = dinheiro real). Usa Upstash Ratelimit sobre o Vercel KV
# acima (KV_REST_API_URL/TOKEN). Sem essas envs (dev local) o gate falha ABERTO
# (não limita) — a proteção só importa em prod, onde as envs existem.
RATE_LIMIT_ANALYSES_PER_DAY=20
RATE_LIMIT_ANALYSES_PER_DAY_ADMIN=200

# ─── Observability ───────────────────────────────────────────────────────────
# Server / edge runtime (not exposed to browser)
SENTRY_DSN=
# Client runtime (public — same DSN value, different env var name)
NEXT_PUBLIC_SENTRY_DSN=
#
# Source-map upload — BUILD-ONLY. Setar como env de build na Vercel (Production);
# o build não falha sem eles, só sobe sem source maps (stack traces ofuscados).
# Comentados aqui porque não são usados em runtime/dev local.
# SENTRY_AUTH_TOKEN= → SECRET, nunca commitar (Sentry → Settings → Auth Tokens;
#                      o plugin grava em .env.sentry-build-plugin, gitignored).
# SENTRY_ORG=        → slug da org, lido por next.config.ts.
# SENTRY_PROJECT=    → slug do projeto, lido por next.config.ts.
#
# Tag `environment` do Sentry (prod × preview). NÃO setar aqui — são injetadas
# pela Vercel: VERCEL_ENV (server/edge) e NEXT_PUBLIC_VERCEL_ENV (browser, exige
# "Enable access to System Environment Variables" ligado). Em dev local caem em NODE_ENV.

# ─── Versionamento / auto-update (ADR 0024) ──────────────────────────────────
# Commit SHA do deploy. VERCEL_GIT_COMMIT_SHA é INJETADA pela Vercel no build
# (NÃO setar aqui). next.config.ts a mapeia pra NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA
# (inlinada no bundle cliente) com fallback "dev" em local — nesse caso o
# detector de versão (banner "nova versão disponível") é no-op. A rota
# /api/version lê VERCEL_GIT_COMMIT_SHA em runtime (no-store) pro cliente comparar.
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
