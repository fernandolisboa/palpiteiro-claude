# ─── Database ────────────────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string.
# Local: defina aqui (em .env.local) com a string da sua Neon branch de dev.
# Vercel (Production/Preview): populada automaticamente pela integração Vercel-Neon
# — Preview recebe uma Neon branch isolada por PR, Production aponta pra Neon main.
# Não setar manualmente no painel do Vercel; a integração toma conta.
DATABASE_URL=

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
# Random secret for signing sessions — generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app (e.g. https://palpiteiro.vercel.app)
AUTH_URL=
# Resend API key used by Auth.js to send magic-link emails
AUTH_RESEND_KEY=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Verified sender address in Resend
RESEND_FROM_EMAIL=

# ─── Anthropic / AI ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── External data providers ─────────────────────────────────────────────────
# The Odds API v4 — free tier: 500 req/month (≈16/day); cache aggressively.
# Auth via query param `?apiKey=<key>` (NÃO header). Quota counters retornam
# nos headers x-requests-remaining / x-requests-used. Sign-up:
# https://the-odds-api.com/ · Doc: https://the-odds-api.com/liveapi/guides/v4/
ODDS_API_KEY=
# API-Football — free tier: 100 req/day. Use direct plan (api-sports.io), NÃO RapidAPI.
# Auth via header x-apisports-key; obtain a key at https://dashboard.api-football.com/.
API_FOOTBALL_KEY=

# ─── Vercel KV (Redis) ───────────────────────────────────────────────────────
# Populated automatically by Vercel when KV store is linked to the project
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
